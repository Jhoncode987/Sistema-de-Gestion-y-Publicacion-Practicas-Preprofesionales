# Copia este archivo como .env y completa los datos de tu PostgreSQL.
# El cliente pg lee estas variables automáticamente.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambia_esta_clave
PGDATABASE=nombre_de_la_base

# Clave para firmar las sesiones (obligatoria, mínimo 32 caracteres).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria_de_32_o_mas

# Puerto del servidor (las plataformas de nube lo asignan automáticamente).
# PORT=3000

# Solo si el frontend se despliega en otra dirección, por ejemplo:
# CORS_ORIGIN=https://mi-frontend.vercel.app

# Con una base en la nube (Neon) basta pegar su cadena de conexión completa.
# Si se define, reemplaza a las variables PG* de arriba:
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
