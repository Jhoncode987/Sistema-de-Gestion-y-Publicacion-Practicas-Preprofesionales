# Copia este archivo como .env y completa los datos de tu PostgreSQL.
# El cliente pg lee estas variables automáticamente.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambia_esta_clave
PGDATABASE=nombre_de_la_base

# Puerto del servidor (las plataformas de nube lo asignan automáticamente).
# PORT=3000

# Solo si el frontend se despliega en otra dirección, por ejemplo:
# CORS_ORIGIN=https://mi-frontend.vercel.app

# Con bases en la nube como Neon suele hacer falta:
# PGSSLMODE=require
